# Copy to terraform.tfvars (gitignored) and adjust. The token is NOT a variable: export GITHUB_TOKEN.

# github_owner = "your-github-username"   # optional; defaults to the token's account

# Flip to true once the account is on GitHub Pro (rulesets on private repos need it).
enable_rulesets = false

# Flip to true only after SSH/GPG commit signing works locally.
require_signed_commits = false

# Jobs a pull request must pass. The default is the three ci.yml jobs already proven on the
# runner. Once figures-fresh (ci.yml) and the security.yml jobs have each run green, require all
# of them (iac-scan-content is advisory by design and is never required):
# required_status_checks = [
#   "secrets-scan", "content-checks", "terraform-validate", "figures-fresh",
#   "actions-lint", "shell-lint", "iac-scan",
# ]

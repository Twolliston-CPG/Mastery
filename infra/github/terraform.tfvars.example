# Copy to terraform.tfvars (gitignored) and adjust. The token is NOT a variable: export GITHUB_TOKEN.

# github_owner = "your-github-username"   # optional; defaults to the token's account

# Flip to true once the account is on GitHub Pro (rulesets on private repos need it).
enable_rulesets = false

# Flip to true only after SSH/GPG commit signing works locally.
require_signed_commits = false

# Jobs a pull request must pass. The default (variables.tf) is all seven jobs in ci.yml and
# security.yml, every one seen green on the runner. Override here only to drop a job that has
# started failing for an environmental reason while it is fixed:
# required_status_checks = ["secrets-scan", "content-checks", "terraform-validate"]

# Access as code (collaborators.tf). Authoritative once manage_collaborators = true: anyone with
# access who is not listed is removed. Import the existing list first (steps in collaborators.tf).
# manage_collaborators = true
# collaborators = {
#   "octocat"  = "push"
#   "hubot"    = "push"
# }

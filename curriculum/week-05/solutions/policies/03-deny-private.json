{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullBucketAccess",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET",
        "arn:aws:s3:::REPLACE_BUCKET/*"
      ]
    },
    {
      "Sid": "ExplicitDenyBeatsEverything",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/private/*"
    }
  ]
}

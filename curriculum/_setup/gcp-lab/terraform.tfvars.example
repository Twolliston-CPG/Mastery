# Copy to terraform.tfvars and fill in.
project_id = "your-lab-project-id"
distro     = "ubuntu" # or "arch" -- see ../DISTRO.md. Choose once: changing it replaces the VM

# region    = "us-central1"
# zone      = "us-central1-a"
# time_zone = "America/New_York"

# enable_serial_console = true            # Week 2: the way back in after an SSH lockout
# open_web              = true            # Week 3
# web_source_ranges     = ["203.0.113.7/32"]   # your own IP; leave the default for Let's Encrypt
# flow_logs             = false

# Arch only. Public key seeded into the VM's metadata for the `arch` user before first boot;
# cloud-init reads it once. Must exist before apply. README step 8 explains.
# ssh_public_key_file   = "~/.ssh/google_compute_engine.pub"

# Kubeadm nodes for the CKA module (weeks 27-30). Off until then. README: "Kubeadm nodes".
# kubeadm_nodes        = 2        # 1 = control plane only; 2 or 3 add workers; 0 removes them
# kubernetes_minor     = "1.34"   # one minor BELOW the exam's version; week 27 Lab 4 upgrades by hand
# kubeadm_machine_type = "e2-medium"
# kubeadm_disk_size_gb = 30
# kubeadm_keep         = false    # true from week 27 if you keep the cluster alive for the mastery ladder (budget ~$50/month)

# .gitignore for mastery/
#
# Principles
#   1. Ignore by *category* (state, credentials, caches, downloads), not by guessing filenames.
#      Broad name patterns such as "*secret*" or "*.json" would hide teaching content that lives
#      in this curriculum (Kubernetes Secret manifests, IAM policy JSON) and are not used.
#   2. A gitignore is hygiene, not a security control. `git add -f` bypasses it and it never
#      removes something already committed. The controls are the gitleaks pre-commit hook and
#      the `secrets-scan` CI job; this file just keeps the common mistakes out of their way.
#   3. Lockfiles are committed: .terraform.lock.hcl, pre-commit revs, Actions SHAs. Never ignore
#      them; they are what makes a build reproducible.
#   4. Keep per-directory .gitignore files where a lab has its own rules (curriculum/_setup/*).
#      This root file is the backstop that applies even if one of those is wrong.

# ---- Operating system ----------------------------------------------------------------------
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Editors and agents ---------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.history/
*.swp
*.swo
*~
.#*
\#*#
.claude/settings.local.json

# ---- Local-only artifacts of this repository -------------------------------------------------
_backups/
curriculum/_shared/diagrams/.tools/
/.tools/
curriculum/_shared/diagrams/_out/
_build/
gnupg/

# ---- Python (toolchain under curriculum/_shared) --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# ---- Node (mermaid-cli, if ever installed outside .tools) ------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# ---- Terraform / OpenTofu --------------------------------------------------------------------
# State and plans contain every attribute of every resource, often including secrets in clear.
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfstate.lock.info
*.tfplan
tfplan
tf.plan
plan.out
# `terraform show -json tf.plan > plan.json` (week 10/19 labs): the JSON plan carries every
# planned attribute value, sensitive ones included.
plan.json
crash.log
crash.*.log
# Real variable values stay local; the committed contract is the *.example file.
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
backend.hcl
*.backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOT ignored on purpose: .terraform.lock.hcl
# Scanner caches: checkov downloads external modules next to the scanned root; tflint plugins.
.external_modules/
.tflint.d/

# ---- Credentials, keys, tokens --------------------------------------------------------------
# Environment files. The committed form is *.example.
.env
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/
# Private keys and keystores, any format.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.gpg
*.asc.sec
# Cloud, cluster, and package-registry credentials.
.aws/
.gcloud/
.azure/
*-service-account*.json
*-sa-key*.json
application_default_credentials.json
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/
.docker/config.json
.npmrc
.pypirc
.netrc
.vault-token
.sops/
*.dec.yaml
*.dec.yml
*.decrypted.*
# Ansible
*.retry
vault-password*
.vault-pass*

# ---- Scanner and supply-chain output --------------------------------------------------------
# trivy/checkov SARIF, syft SBOMs, cosign signatures and attestations are produced per build and
# belong in the pipeline's artifact store, not in the source tree (week 17-19 labs).
*.sarif
sbom.*
*.spdx.json
*.cdx.json
*.sig
*.att
.trivycache/

# ---- Build and runtime output ---------------------------------------------------------------
dist/
build/
out/
*.log
logs/
tmp/
*.tmp
*.bak
*.orig
*.rej
# Disk images and archives are downloads, never sources (see curriculum/_setup/gcp-lab/image).
# Covers the fetched image tarballs, `docker save` exports, and the old gcp-lab/state.zip snapshot.
*.qcow2
*.raw
*.iso
*.vmdk
*.ova
*.tar
*.tar.gz
*.tgz
*.zip
